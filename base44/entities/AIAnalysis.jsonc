{
  "name": "AIAnalysis",
  "type": "object",
  "properties": {
    "collectible_id": {
      "type": "string"
    },
    "analysis_type": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "confidence": {
      "type": "string"
    },
    "identification_data": {
      "type": "string"
    },
    "pricing_data": {
      "type": "string"
    }
  },
  "required": [
    "collectible_id",
    "analysis_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}