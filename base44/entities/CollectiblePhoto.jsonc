{
  "name": "CollectiblePhoto",
  "type": "object",
  "properties": {
    "collectible_id": {
      "type": "string"
    },
    "photo_type": {
      "type": "string",
      "enum": [
        "front",
        "back",
        "left",
        "right",
        "top",
        "bottom",
        "obverse",
        "reverse",
        "edge",
        "edges",
        "corners",
        "surface",
        "centering",
        "scratches",
        "damage",
        "certificate",
        "autograph",
        "additional"
      ],
      "default": "front"
    },
    "photo_url": {
      "type": "string"
    }
  },
  "required": [
    "collectible_id",
    "photo_type",
    "photo_url"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}