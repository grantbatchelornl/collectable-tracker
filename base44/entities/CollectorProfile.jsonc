{
  "name": "CollectorProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "show_public_value": {
      "type": "boolean",
      "default": false
    },
    "favorite_categories": {
      "type": "string"
    },
    "favorite_sets": {
      "type": "string"
    },
    "favorite_franchises": {
      "type": "string"
    },
    "favorite_athletes": {
      "type": "string"
    },
    "favorite_teams": {
      "type": "string"
    },
    "favorite_characters": {
      "type": "string"
    },
    "budget": {
      "type": "number",
      "default": 0
    },
    "goals": {
      "type": "string"
    },
    "risk_tolerance": {
      "type": "string",
      "enum": [
        "conservative",
        "moderate",
        "aggressive"
      ],
      "default": "moderate"
    },
    "leaderboard_opt_in": {
      "type": "boolean",
      "default": false
    },
    "leaderboard_scope": {
      "type": "string",
      "enum": [
        "global_friends",
        "friends_only",
        "hidden"
      ],
      "default": "hidden"
    },
    "hide_collection_value": {
      "type": "boolean",
      "default": false
    },
    "hide_individual_collectibles": {
      "type": "boolean",
      "default": false
    },
    "hide_purchase_prices": {
      "type": "boolean",
      "default": false
    },
    "last_week_rank": {
      "type": "number"
    },
    "price_increase_threshold": {
      "type": "number",
      "default": 10
    },
    "price_decrease_threshold": {
      "type": "number",
      "default": 10
    },
    "health_reminder_enabled": {
      "type": "boolean",
      "default": true
    },
    "binder_scan_count": {
      "type": "number",
      "default": 0
    },
    "dashboard_widgets": {
      "type": "string"
    },
    "vacation_mode": {
      "type": "boolean",
      "default": false
    },
    "is_verified_trader": {
      "type": "boolean",
      "default": false
    },
    "is_influencer": {
      "type": "boolean",
      "default": false
    },
    "influencer_platform": {
      "type": "string",
      "enum": [
        "YouTube",
        "TikTok",
        "Instagram",
        "Twitch",
        "X (Twitter)",
        "Facebook",
        "Other"
      ]
    },
    "influencer_handle": {
      "type": "string"
    },
    "convention_mode_active": {
      "type": "boolean",
      "default": false
    },
    "convention_lat": {
      "type": "number"
    },
    "convention_lng": {
      "type": "number"
    },
    "convention_name": {
      "type": "string"
    },
    "trade_reputation_score": {
      "type": "number",
      "default": 0
    },
    "trade_review_count": {
      "type": "number",
      "default": 0
    },
    "total_completed_trades": {
      "type": "number",
      "default": 0
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "level": {
      "type": "number",
      "default": 1
    },
    "xp_to_next_level": {
      "type": "number",
      "default": 100
    },
    "ai_enabled": {
      "type": "boolean",
      "default": true
    },
    "ai_response_detail": {
      "type": "string",
      "enum": [
        "brief",
        "standard",
        "detailed"
      ],
      "default": "standard"
    },
    "ai_collector_level": {
      "type": "string",
      "enum": [
        "beginner",
        "advanced"
      ],
      "default": "beginner"
    },
    "ai_recommendation_style": {
      "type": "string",
      "enum": [
        "conservative",
        "balanced",
        "aggressive"
      ],
      "default": "balanced"
    },
    "ai_enable_recommendations": {
      "type": "boolean",
      "default": true
    },
    "ai_enable_binder_suggestions": {
      "type": "boolean",
      "default": true
    },
    "ai_enable_trade_suggestions": {
      "type": "boolean",
      "default": true
    },
    "ai_enable_grading_suggestions": {
      "type": "boolean",
      "default": true
    },
    "ai_enable_health_suggestions": {
      "type": "boolean",
      "default": true
    },
    "ai_include_purchase_price": {
      "type": "boolean",
      "default": false
    },
    "ai_include_manual_values": {
      "type": "boolean",
      "default": true
    },
    "ai_save_history": {
      "type": "boolean",
      "default": true
    },
    "ai_auto_confirm_routine": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}