{
  "name": "CollectorProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "show_public_value": {
      "type": "boolean",
      "default": false
    },
    "favorite_categories": {
      "type": "string"
    },
    "favorite_sets": {
      "type": "string"
    },
    "favorite_franchises": {
      "type": "string"
    },
    "favorite_athletes": {
      "type": "string"
    },
    "favorite_teams": {
      "type": "string"
    },
    "favorite_characters": {
      "type": "string"
    },
    "budget": {
      "type": "number",
      "default": 0
    },
    "goals": {
      "type": "string"
    },
    "risk_tolerance": {
      "type": "string",
      "enum": [
        "conservative",
        "moderate",
        "aggressive"
      ],
      "default": "moderate"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}