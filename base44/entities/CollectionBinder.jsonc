{
  "name": "CollectionBinder",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "franchise": {
      "type": "string"
    },
    "set_name": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "target_count": {
      "type": "number",
      "default": 0
    },
    "checklist_json": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string"
    },
    "privacy_status": {
      "type": "string",
      "enum": [
        "private",
        "friends",
        "public"
      ],
      "default": "private"
    },
    "cost_estimates_json": {
      "type": "string"
    },
    "cost_estimates_date": {
      "type": "string"
    },
    "owned_count": {
      "type": "number",
      "default": 0
    },
    "completion_percent": {
      "type": "number",
      "default": 0
    },
    "last_milestone_notified": {
      "type": "number",
      "default": 0
    },
    "completion_date": {
      "type": "string",
      "format": "date"
    },
    "completion_snapshot": {
      "type": "string"
    },
    "binder_type": {
      "type": "string",
      "enum": [
        "master",
        "custom"
      ],
      "default": "custom"
    },
    "cover_photo_url": {
      "type": "string"
    },
    "color": {
      "type": "string"
    },
    "sorting": {
      "type": "string",
      "enum": [
        "number",
        "value",
        "name",
        "rarity"
      ],
      "default": "number"
    },
    "view_mode": {
      "type": "string",
      "enum": [
        "grid",
        "list",
        "gallery",
        "large",
        "small",
        "binder"
      ],
      "default": "grid"
    },
    "ai_prompt": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.privacy_status": "public"
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}