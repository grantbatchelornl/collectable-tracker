{
  "name": "Message",
  "type": "object",
  "properties": {
    "sender_id": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "sender_name": {
      "type": "string"
    },
    "recipient_name": {
      "type": "string"
    },
    "sender_photo": {
      "type": "string"
    },
    "recipient_photo": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "attached_collectible_id": {
      "type": "string"
    },
    "attached_collectible_name": {
      "type": "string"
    },
    "attached_collectible_photo": {
      "type": "string"
    },
    "attached_collectible_value": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "sender_id",
    "recipient_id",
    "body"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "system_only"
      }
    },
    "read": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sender_id": "{{user.id}}"
        },
        {
          "data.recipient_id": "{{user.id}}"
        }
      ]
    }
  }
}