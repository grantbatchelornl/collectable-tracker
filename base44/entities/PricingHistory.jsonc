{
  "name": "PricingHistory",
  "type": "object",
  "properties": {
    "collectible_id": {
      "type": "string"
    },
    "collectible_name": {
      "type": "string"
    },
    "estimated_value": {
      "type": "number",
      "default": 0
    },
    "low_value": {
      "type": "number",
      "default": 0
    },
    "high_value": {
      "type": "number",
      "default": 0
    },
    "average_price": {
      "type": "number",
      "default": 0
    },
    "pricing_source": {
      "type": "string",
      "default": "Manual"
    },
    "value_type": {
      "type": "string",
      "enum": [
        "verified_sold",
        "manual"
      ],
      "default": "manual"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "low"
    },
    "comparables_count": {
      "type": "number",
      "default": 0
    },
    "most_recent_sale_date": {
      "type": "string"
    },
    "comparable_date_range": {
      "type": "string"
    },
    "matching_criteria": {
      "type": "string"
    },
    "includes_shipping": {
      "type": "boolean",
      "default": false
    },
    "is_stale": {
      "type": "boolean",
      "default": false
    },
    "valuation_notes": {
      "type": "string"
    }
  },
  "required": [
    "collectible_id",
    "estimated_value"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}