{
  "name": "Achievement",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "badge_type": {
      "type": "string"
    },
    "badge_name": {
      "type": "string"
    },
    "badge_icon": {
      "type": "string"
    },
    "badge_description": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "badge_type"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": true,
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}