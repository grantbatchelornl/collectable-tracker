{
  "name": "Notification",
  "type": "object",
  "properties": {
    "recipient_id": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "destination_route": {
      "type": "string"
    },
    "destination_id": {
      "type": "string"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "icon": {
      "type": "string"
    }
  },
  "required": [
    "recipient_id",
    "type",
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}",
      "data.recipient_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.recipient_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "data.recipient_id": "{{user.id}}"
    },
    "delete": {
      "data.recipient_id": "{{user.id}}"
    }
  }
}