{
  "name": "Watchlist",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "item_name": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "category_name": {
      "type": "string"
    },
    "collectible_id": {
      "type": "string"
    },
    "target_price": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "friends",
        "public"
      ],
      "default": "private"
    },
    "alerts_enabled": {
      "type": "boolean",
      "default": true
    },
    "raw_or_graded": {
      "type": "string",
      "enum": [
        "any",
        "raw",
        "graded"
      ],
      "default": "any"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "acquired",
        "abandoned"
      ],
      "default": "active"
    }
  },
  "required": [
    "user_id",
    "item_name"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.visibility": "public"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}