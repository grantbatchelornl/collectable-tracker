{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin",
        "super_admin"
      ],
      "default": "user"
    },
    "display_name": {
      "type": "string"
    },
    "username": {
      "type": "string"
    },
    "bio": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "has_completed_onboarding": {
      "type": "boolean",
      "default": false
    },
    "is_suspended": {
      "type": "boolean",
      "default": false
    },
    "privacy_show_public_value": {
      "type": "boolean",
      "default": false
    },
    "notification_in_app_enabled": {
      "type": "boolean",
      "default": true
    }
  }
}