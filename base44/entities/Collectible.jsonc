{
  "name": "Collectible",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "category_name": {
      "type": "string"
    },
    "character_athlete_name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "product_line": {
      "type": "string"
    },
    "set_name": {
      "type": "string"
    },
    "set_number": {
      "type": "string"
    },
    "card_number": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "team": {
      "type": "string"
    },
    "variant": {
      "type": "string"
    },
    "edition": {
      "type": "string"
    },
    "parallel": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "has_autograph": {
      "type": "boolean",
      "default": false
    },
    "grading_company": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "box_condition": {
      "type": "string"
    },
    "item_condition": {
      "type": "string"
    },
    "authentication_company": {
      "type": "string"
    },
    "estimated_value": {
      "type": "number",
      "default": 0
    },
    "low_value": {
      "type": "number",
      "default": 0
    },
    "high_value": {
      "type": "number",
      "default": 0
    },
    "value_source": {
      "type": "string",
      "default": "Manual"
    },
    "value_locked": {
      "type": "boolean",
      "default": false
    },
    "privacy_status": {
      "type": "string",
      "enum": [
        "private",
        "friends",
        "public"
      ],
      "default": "private"
    },
    "primary_photo_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "item_name",
    "estimated_value"
  ],
  "rls": {
    "create": null,
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}