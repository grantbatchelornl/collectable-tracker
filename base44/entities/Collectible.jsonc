{
  "name": "Collectible",
  "type": "object",
  "properties": {
    "item_name": {
      "type": "string"
    },
    "category_id": {
      "type": "string"
    },
    "category_name": {
      "type": "string"
    },
    "character_athlete_name": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "product_line": {
      "type": "string"
    },
    "set_name": {
      "type": "string"
    },
    "set_number": {
      "type": "string"
    },
    "card_number": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "team": {
      "type": "string"
    },
    "variant": {
      "type": "string"
    },
    "edition": {
      "type": "string"
    },
    "parallel": {
      "type": "string"
    },
    "serial_number": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "has_autograph": {
      "type": "boolean",
      "default": false
    },
    "grading_company": {
      "type": "string"
    },
    "grade": {
      "type": "string"
    },
    "box_condition": {
      "type": "string"
    },
    "item_condition": {
      "type": "string"
    },
    "authentication_company": {
      "type": "string"
    },
    "franchise": {
      "type": "string"
    },
    "box_number": {
      "type": "string"
    },
    "series": {
      "type": "string"
    },
    "is_exclusive": {
      "type": "boolean",
      "default": false
    },
    "has_sticker": {
      "type": "boolean",
      "default": false
    },
    "is_chase": {
      "type": "boolean",
      "default": false
    },
    "is_boxed": {
      "type": "boolean",
      "default": false
    },
    "country": {
      "type": "string"
    },
    "denomination": {
      "type": "string"
    },
    "mint_mark": {
      "type": "string"
    },
    "composition": {
      "type": "string"
    },
    "sport": {
      "type": "string"
    },
    "is_rookie": {
      "type": "boolean",
      "default": false
    },
    "has_patch": {
      "type": "boolean",
      "default": false
    },
    "item_type": {
      "type": "string"
    },
    "is_game_used": {
      "type": "boolean",
      "default": false
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "estimated_value": {
      "type": "number",
      "default": 0
    },
    "low_value": {
      "type": "number",
      "default": 0
    },
    "high_value": {
      "type": "number",
      "default": 0
    },
    "average_price": {
      "type": "number",
      "default": 0
    },
    "purchase_cost": {
      "type": "number",
      "default": 0
    },
    "value_source": {
      "type": "string",
      "default": "Manual"
    },
    "value_type": {
      "type": "string",
      "enum": [
        "verified_sold",
        "manual"
      ],
      "default": "manual"
    },
    "value_locked": {
      "type": "boolean",
      "default": false
    },
    "value_confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ],
      "default": "low"
    },
    "comparables_count": {
      "type": "number",
      "default": 0
    },
    "most_recent_sale_date": {
      "type": "string"
    },
    "comparable_date_range": {
      "type": "string"
    },
    "matching_criteria": {
      "type": "string"
    },
    "includes_shipping": {
      "type": "boolean",
      "default": false
    },
    "is_stale": {
      "type": "boolean",
      "default": false
    },
    "valuation_notes": {
      "type": "string"
    },
    "for_sale": {
      "type": "boolean",
      "default": false
    },
    "asking_price": {
      "type": "number",
      "default": 0
    },
    "trade_status": {
      "type": "string",
      "enum": [
        "keep",
        "trade",
        "sell"
      ],
      "default": "keep"
    },
    "privacy_status": {
      "type": "string",
      "enum": [
        "private",
        "friends",
        "public"
      ],
      "default": "private"
    },
    "primary_photo_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_deleted": {
      "type": "boolean",
      "default": false
    },
    "deleted_date": {
      "type": "string"
    },
    "is_favorite": {
      "type": "boolean",
      "default": false
    },
    "folder_id": {
      "type": "string"
    },
    "version": {
      "type": "number",
      "default": 1
    }
  },
  "required": [
    "item_name",
    "estimated_value"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.privacy_status": "public"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}