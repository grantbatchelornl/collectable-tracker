{
  "name": "CollectionValueSnapshot",
  "type": "object",
  "properties": {
    "total_value": {
      "type": "number"
    },
    "verified_value": {
      "type": "number"
    },
    "manual_value": {
      "type": "number"
    },
    "total_cost": {
      "type": "number"
    },
    "item_count": {
      "type": "number"
    },
    "category_breakdown": {
      "type": "string"
    }
  },
  "required": [
    "total_value"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": false,
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}